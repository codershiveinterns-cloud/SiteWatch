# --- Database -------------------------------------------------------------
# PostgreSQL connection string used by Prisma (migrations + runtime).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sitewatch_dev"

# --- Application ----------------------------------------------------------
# Public origin of the deployment. Used for absolute links and cookie policy.
APP_URL="http://localhost:3000"

# Session lifetime in days. Sessions are server-side; the cookie only carries
# an opaque token.
SESSION_TTL_DAYS=30

# Set to "true" only on staging/preview environments to enable the demo
# organization seed (prisma/seed.ts). Never enable on production.
ALLOW_DEMO_SEED="true"
