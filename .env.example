# --- Database -------------------------------------------------------------
# Local SQLite file (default). No external database service is required.
DATABASE_URL="file:./prisma/sitewatch.db"

# --- Application ----------------------------------------------------------
# Public origin. Optional: on Vercel the deployment URL is used automatically.
APP_URL="http://localhost:3000"

# Session lifetime in days (server-side sessions; cookie holds an opaque token).
SESSION_TTL_DAYS=30

# "true" enables the demo organizations in `prisma db seed` (dev/staging only).
ALLOW_DEMO_SEED="true"
