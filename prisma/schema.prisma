// SiteWatch — Milestone 1 schema
//
// Tenancy model
// -------------
// Organization is the tenant boundary. Every organization-owned resource
// introduced in later milestones (Site, Asset, Incident, Alert, TelemetryEvent,
// AuditLog, ...) MUST carry an `organizationId` foreign key and be queried
// through the tenant-scoped helpers in `src/lib/tenant.ts`.
//
// Users are global identities (unique by email). A user joins an organization
// through a Membership, which carries the user's Role inside that tenant.
// This keeps the door open for a single user belonging to several tenants
// (e.g. a contractor technician) without a schema change.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  OPERATIONS_MANAGER
  FIELD_TECHNICIAN
  VIEWER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  /// URL-safe identifier, unique across the platform (used for tenant context,
  /// future subdomains and API namespacing).
  slug      String   @unique
  /// IANA timezone used for SLA timers and reporting in later milestones.
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
  sites       Site[]
  assets      Asset[]
  ingestKeys  IngestKey[]
  telemetry   TelemetryEvent[]
  rejected    RejectedEvent[]

  @@index([createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(VIEWER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

/// Server-side session. The browser only holds an opaque random token; the
/// database stores its SHA-256 hash, so a leaked database row cannot be used
/// to hijack a session.
model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  /// The tenant this session is currently acting in. Set at sign-in from the
  /// user's membership; future org-switching updates this field only.
  organizationId String
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime @default(now())
  lastActiveAt   DateTime @default(now())
  expiresAt      DateTime

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Milestone 2 — Site & asset registry, telemetry ingestion
// ---------------------------------------------------------------------------

enum SiteCategory {
  SOLAR_FARM
  TELECOM_TOWER
  EV_STATION
  WAREHOUSE
  CONSTRUCTION_SITE
}

enum AssetStatus {
  HEALTHY
  AT_RISK
  CRITICAL
  OFFLINE
  UNKNOWN
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
}

model Site {
  id             String       @id @default(cuid())
  organizationId String
  /// Short human code, unique per organization (e.g. "NW-SOL-01").
  code           String
  name           String
  category       SiteCategory
  latitude       Float
  longitude      Float
  address        String?
  timezone       String?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       Asset[]

  @@unique([organizationId, code])
  @@index([organizationId, category])
  @@index([organizationId, name])
}

model Asset {
  id             String      @id @default(cuid())
  organizationId String
  siteId         String
  /// Asset tag, unique per organization (e.g. "INV-2"). Used by telemetry payloads.
  tag            String
  name           String
  type           String
  manufacturer   String?
  model          String?
  serialNumber   String?
  installDate    DateTime?
  status         AssetStatus @default(UNKNOWN)
  criticality    Criticality @default(MEDIUM)
  /// JSON object of free-form specifications (SQLite has no JSON column type).
  specifications String?
  maintenanceIntervalDays Int?
  lastMaintenanceAt       DateTime?
  nextMaintenanceAt       DateTime?
  lastTelemetryAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  telemetry    TelemetryEvent[]

  @@unique([organizationId, tag])
  @@index([organizationId, siteId])
  @@index([organizationId, status])
  @@index([organizationId, nextMaintenanceAt])
}

/// API key for the telemetry ingestion endpoint. Only the hash is stored.
model IngestKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyPrefix      String
  keyHash        String    @unique
  createdById    String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model TelemetryEvent {
  id             String   @id @default(cuid())
  organizationId String
  assetId        String
  metric         String
  value          Float
  unit           String?
  recordedAt     DateTime
  receivedAt     DateTime @default(now())
  source         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, metric, recordedAt])
  @@index([organizationId, receivedAt])
}

/// Payloads rejected by the ingestion endpoint, kept for troubleshooting.
model RejectedEvent {
  id             String   @id @default(cuid())
  organizationId String?
  ingestKeyId    String?
  reason         String
  payload        String
  receivedAt     DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, receivedAt])
}
